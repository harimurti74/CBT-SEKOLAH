{
  "entities": {
    "Exam": {
      "title": "Exam",
      "description": "Configuration and metadata for a school CBT exam workspace.",
      "type": "object",
      "properties": {
        "examId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "appTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "schoolName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "schoolLevel": {
          "type": "string",
          "enum": ["SD/MI", "SMP/MTs", "SMA/MA/SMK/MAK", "SLB"],
          "minLength": 2,
          "maxLength": 30
        },
        "token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "gdriveUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "mapels": {
          "type": "array"
        },
        "kelas": {
          "type": "array"
        },
        "durationMinutes": {
          "type": "number"
        },
        "maxViolations": {
          "type": "number"
        },
        "shuffleQuestions": {
          "type": "boolean"
        },
        "verificationMode": {
          "type": "string",
          "enum": ["crosscheck", "manual"],
          "minLength": 3,
          "maxLength": 20
        },
        "rosterCount": {
          "type": "number"
        },
        "subjectsCount": {
          "type": "number"
        },
        "imagesCount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "examId",
        "ownerUid",
        "appTitle",
        "schoolName",
        "schoolLevel",
        "token",
        "gdriveUrl",
        "mapels",
        "kelas",
        "durationMinutes",
        "maxViolations",
        "shuffleQuestions",
        "verificationMode",
        "rosterCount",
        "subjectsCount",
        "imagesCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "SubjectBank": {
      "title": "SubjectBank",
      "description": "Uploaded question types, variant codes, and answer keys for one subject in an exam.",
      "type": "object",
      "properties": {
        "examId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "subjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "subjectName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "questions": {
          "type": "array"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "examId",
        "subjectId",
        "subjectName",
        "ownerUid",
        "questions",
        "updatedAt"
      ]
    },
    "QuestionImage": {
      "title": "QuestionImage",
      "description": "Uploaded JPG/PNG/WebP question slide image indexed by normalized filename.",
      "type": "object",
      "properties": {
        "examId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "imageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "cleanName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "sizeKb": {
          "type": "number"
        },
        "dataUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 950000
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "examId",
        "imageId",
        "name",
        "cleanName",
        "type",
        "sizeKb",
        "dataUrl",
        "ownerUid",
        "updatedAt"
      ]
    },
    "RosterStudent": {
      "title": "RosterStudent",
      "description": "Master student record for crosschecking participant identity.",
      "type": "object",
      "properties": {
        "examId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "rosterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "no": {
          "type": "number"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "noPeserta": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "className": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "examId",
        "rosterId",
        "no",
        "name",
        "noPeserta",
        "className",
        "subject",
        "ownerUid",
        "updatedAt"
      ]
    },
    "StudentSubmission": {
      "title": "StudentSubmission",
      "description": "Student exam session, answers, violations, and computed score.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "examId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "schoolName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "studentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "noPeserta": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "className": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "assignedPackage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "answers": {
          "type": "object"
        },
        "violationsCount": {
          "type": "number"
        },
        "startTime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "submitTime": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "score": {
          "type": "number"
        },
        "maxScore": {
          "type": "number"
        },
        "percentage": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["Sedang Mengerjakan", "Selesai", "Curang (Disubmit)", "Direset"],
          "minLength": 3,
          "maxLength": 40
        },
        "syncedToGdrive": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "examId",
        "ownerUid",
        "token",
        "schoolName",
        "studentName",
        "noPeserta",
        "className",
        "subject",
        "assignedPackage",
        "answers",
        "violationsCount",
        "startTime",
        "submitTime",
        "score",
        "maxScore",
        "percentage",
        "status",
        "syncedToGdrive",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized admin registry record.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt"]
    }
  },
  "firestore": {
    "/exams/{examId}": {
      "schema": { "$ref": "#/entities/Exam" },
      "description": "Exam configuration document owned by a verified teacher."
    },
    "/exams/{examId}/banks/{subjectId}": {
      "schema": { "$ref": "#/entities/SubjectBank" },
      "description": "Question bank per subject for an exam."
    },
    "/exams/{examId}/images/{imageId}": {
      "schema": { "$ref": "#/entities/QuestionImage" },
      "description": "Question slide images indexed by normalized filename."
    },
    "/exams/{examId}/roster/{rosterId}": {
      "schema": { "$ref": "#/entities/RosterStudent" },
      "description": "Master student roster entries indexed by normalized participant number."
    },
    "/exams/{examId}/submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/StudentSubmission" },
      "description": "Student exam sessions and submitted scores."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Platform admin accounts."
    }
  }
}
